# Lovable Cloud / Supabase publishable values (auto-generated for each project).
# Real .env is provisioned by Lovable — do NOT commit it.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Браузерные push-уведомления. На VM задаются без префикса VITE:
# VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY и VAPID_SUBJECT.
# Скрипт deploy-vm-test.sh передаёт публичный ключ в фронтенд автоматически.
